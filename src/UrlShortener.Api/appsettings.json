{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=urlshortener.db"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ShortLinks": {
    "PublicBaseUrl": "http://localhost:8080"
  },
  "RateLimiting": {
    "Create": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Redirect": {
      "BurstLimit": 60,
      "TokensPerSecond": 2
    },
    "Read": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
